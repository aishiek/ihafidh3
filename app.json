{
  "expo": {
    "name": "iHafidh",
    "slug": "ihafidh2",
    "version": "1.3.1",
    "orientation": "default",
    "userInterfaceStyle": "dark",
    "newArchEnabled": true,
    "icon": "./assets/images/icon.png",
    "splash": {
      "image": "./assets/images/splash.png",
      "resizeMode": "cover",
      "backgroundColor": "#1a1a1a"
    },
    "assetBundlePatterns": [
       "**/*",
      "assets/**/*"
    ],
    "plugins": [
      "expo-router",
      "expo-sqlite",
      [
        "expo-notifications",
        {
          "icon": "./assets/images/icon.png",
          "color": "#ffffff",
          "defaultChannel": "default"
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "compileSdkVersion": 35,
            "targetSdkVersion": 35,
            "buildToolsVersion": "35.0.0",
            "hermesEnabled": false
          },
          "ios": {
            "hermesEnabled": true,
            "deploymentTarget": "15.1"
          }
        }
      ]
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.ihafidh",
      "buildNumber": "11",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "This app needs access to your location to determine Qibla direction and to enhance fasting calendar accuracy.",
        "ITSAppUsesNonExemptEncryption": false,
        "NSCameraUsageDescription": "Camera access can be used for potential future features (e.g., scanning).",
        "NSPhotoLibraryAddUsageDescription": "Needed if you choose to save images from the app.",
        "NSPhotoLibraryUsageDescription": "Allows selecting or saving images related to your progress.",
        "UIBackgroundModes": [
          "audio",
          "fetch"
        ],
        "NSAppTransportSecurity": {
          "NSExceptionDomains": {
            "cdn.islamic.network": {
              "NSExceptionAllowsInsecureHTTPLoads": false,
              "NSIncludesSubdomains": true,
              "NSTemporaryExceptionAllowsInsecureHTTPLoads": true,
              "NSExceptionMinimumTLSVersion": "TLSv1.0",
              "NSExceptionRequiresForwardSecrecy": false
            },
            "everyayah.com": {
              "NSExceptionAllowsInsecureHTTPLoads": false,
              "NSIncludesSubdomains": true,
              "NSTemporaryExceptionAllowsInsecureHTTPLoads": true,
              "NSExceptionMinimumTLSVersion": "TLSv1.0",
              "NSExceptionRequiresForwardSecrecy": false
            }
          }
        },
        "CFBundleAllowMixedLocalizations": true,
        "UIRequiresFullScreen": false,
        "UISupportedInterfaceOrientations": [
          "UIInterfaceOrientationPortrait"
        ],
        "UISupportedInterfaceOrientations~ipad": [
          "UIInterfaceOrientationPortrait",
          "UIInterfaceOrientationPortraitUpsideDown",
          "UIInterfaceOrientationLandscapeLeft",
          "UIInterfaceOrientationLandscapeRight"
        ]
      },
      "runtimeVersion": {
        "policy": "sdkVersion"
      }
    },
    "android": {
      "package": "com.ihafidh",
      "versionCode": 24,
      "permissions": [
        "ACCESS_FINE_LOCATION",
        "ACCESS_COARSE_LOCATION",
        "RECEIVE_BOOT_COMPLETED",
        "VIBRATE",
        "WAKE_LOCK",
        "POST_NOTIFICATIONS"
      ],
      "blockedPermissions": [
        "android.permission.ACTIVITY_RECOGNITION"
      ],
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/icon.png",
        "backgroundColor": "#1a1a1a"
      },
      "intentFilters": [
        {
          "action": "VIEW",
          "data": [
            {
              "scheme": "ihafidh"
            }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        }
      ]
    },
    "web": {
      "favicon": "./assets/images/favicon.png",
      "output": "static"
    },
    "scheme": "ihafidh",
    "description": "Master Quran memorization with iHafidh - your comprehensive digital companion for Hifdh (Quran Memorization) with detailed statistics and progress tracking. Monitor your journey across all 114 Surahs and 30 Juz with visual progress indicators, performance analytics, and spaced repetition techniques. No matter at what age you are this app will be a great companion for Muslims to memorize from short surahs to long ones and keeping track of progress. Key Features: Complete progress tracking for all 114 chapters (Surahs); Visual progress indicators for all 30 Juz sections; Detailed memorization statistics and performance metrics; Spaced repetition system for optimal retention; High-quality audio recitations with verse-by-verse practice; Customizable study plans and smart reminders; Achievement badges and milestone celebrations. Track every verse, monitor retention rates, and visualize your Hifdh progress with comprehensive statistics.",
    "extra": {
      "router": {},
      "eas": {
        "projectId": "e413fa80-10eb-4452-ab9f-b195e2b526b2"
      },
      "privacyPolicyUrl": "https://aishiek.github.io/",
      "supportUrl": "https://aishiek.github.io/",
      "keywords": "Vibe Coded Quran Memorization Statistic app complete stats with Intelligent quiz feature"
    },
    "updates": {
      "enabled": true,
      "checkAutomatically": "ON_LOAD",
      "fallbackToCacheTimeout": 30000
    }
  }
}
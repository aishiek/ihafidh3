rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Community Stats — readable by all, writable only by increments
    match /community_stats/global {
      allow read: if true;
      allow create, update: if true;
    }

    // Surah Stats — readable by all, constrained by valid 1..114 ID
    match /surah_stats/{surahId} {
      allow read: if true;
      allow create, update: if int(surahId) >= 1 && int(surahId) <= 114;
    }

    // Juz Stats — readable by all, constrained by valid 1..30 ID
    match /juz_stats/{juzId} {
      allow read: if true;
      allow create, update: if int(juzId) >= 1 && int(juzId) <= 30;
    }

    // Badge Stats — readable by all, valid badge IDs
    match /badge_stats/{badgeId} {
      allow read: if true;
      allow create, update: if badgeId in ['awwal-noor', 'munir-al-darb', 'hamil-hikmah', 'sahib-istiqaamah',
                  'saari-sabeelillah', 'sahib-azm', 'naasir-quran', 'rahiq-yaqeen', 'hafidh-quran'];
    }
  }
}

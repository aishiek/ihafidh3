{
  "name": "ihafidh3",
  "main": "expo-router/entry",
  "version": "1.0.0",
  "scripts": {
    "start": "expo start --dev-client",
    "android": "cross-env NODE_ENV=development expo run:android",
    "ios": "cross-env NODE_ENV=development expo run:ios",
    "web": "expo start --web",
    "clean:metro": "react-native start --reset-cache",
    "clean:android": "cd android && ./gradlew clean",
    "clean:all": "rm -rf node_modules android/.gradle android/build android/app/build .expo .expo-shared && npm cache clean --force",
    "reinstall": "rm -rf node_modules && npm install",
    "doctor": "npx react-native doctor",
    "build:apk:debug": "cd android && ./gradlew :app:assembleDebug",
    "build:apk:release": "cross-env NODE_ENV=production npm run clean && cd android && ./gradlew assembleRelease --stacktrace && cd ..",
    "install:apk:debug": "adb install -r android/app/build/outputs/apk/debug/app-debug.apk",
    "install:apk:release": "adb install -r android/app/build/outputs/apk/release/app-release.apk",
    "logcat": "adb logcat ReactNative:V ReactNativeJS:V AndroidRuntime:E *:S",
    "start:clean": "expo start -c --dev-client",
    "rebuild": "rm -rf node_modules android/.gradle android/build android/app/build .expo .expo-shared && npm install && npx expo prebuild && npx expo run:android",
    "build": "cross-env NODE_ENV=production expo build",
    "preview": "cross-env NODE_ENV=production eas build --profile preview",
    "clean": "rm -rf android/app/build .expo .expo-shared node_modules/.cache && cd android && ./gradlew clean && cd ..",
    "lint": "expo lint"
  },
  "dependencies": {
    "@babel/runtime": "^7.26.0",
    "@react-native-async-storage/async-storage": "2.1.2",
    "@react-native-masked-view/masked-view": "0.3.2",
    "@react-native-picker/picker": "2.11.1",
    "babel-preset-expo": "~13.0.0",
    "expo": "~53.0.2",
    "expo-audio": "~0.4.9",
    "expo-build-properties": "~0.14.0",
    "expo-constants": "~17.1.7",
    "expo-haptics": "~14.1.4",
    "expo-image": "~2.4.0",
    "expo-linear-gradient": "~14.1.5",
    "expo-linking": "~7.1.7",
    "expo-location": "~18.1.6",
    "expo-notifications": "~0.31.0",
    "expo-router": "~5.1.6",
    "expo-sensors": "~14.1.4",
    "expo-sqlite": "~15.2.14",
    "expo-status-bar": "~2.2.3",
    "expo-web-browser": "~14.2.0",
    "hijri-converter": "^1.1.1",
    "lucide-react-native": "^0.511.0",
    "moti": "^0.30.0",
    "react": "19.0.0",
    "react-dom": "19.0.0",
    "react-native": "0.79.5",
    "react-native-reanimated": "~3.17.4",
    "react-native-safe-area-context": "5.4.0",
    "react-native-screens": "~4.11.1",
    "react-native-svg": "15.11.2",
    "react-native-web": "^0.20.0",
    "rn-tajweed-verse": "^1.0.1",
    "zustand": "^5.0.5",
    "expo-dev-client": "~5.2.4"
  },
  "overrides": {
    "react-native": "0.79.5"
  },
  "devDependencies": {
    "@babel/core": "^7.26.0",
    "@babel/plugin-transform-class-properties": "^7.27.1",
    "@babel/plugin-transform-private-methods": "^7.27.1",
    "@babel/plugin-transform-private-property-in-object": "^7.27.1",
    "@babel/plugin-transform-runtime": "^7.28.3",
    "@react-native-community/cli": "^20.0.0",
    "@react-native/metro-config": "^0.79.5",
    "@types/dotenv": "^6.1.1",
    "@types/react": "~19.0.0",
    "@types/react-dom": "~19.0.0",
    "@types/uuid": "^10.0.0",
    "babel-plugin-module-resolver": "^5.0.2",
    "babel-plugin-transform-remove-console": "^6.9.4",
    "babel-preset-expo": "~13.0.0",
    "cross-env": "^10.0.0",
    "dotenv": "^16.4.7",
    "patch-package": "^8.0.0",
    "react-native-dotenv": "^3.4.11",
    "typescript": "~5.8.3"
  },
  "private": true
}

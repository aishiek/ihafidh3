  tabTextActive: { color: '#ffffff' },
  khatamDate: { color: '#4CAF50', fontFamily: 'ScheherazadeNew-Regular', fontSize: 12, textAlign: 'right', marginLeft: 8 },
  verseList: { padding: 16, paddingBottom: 100 },
});
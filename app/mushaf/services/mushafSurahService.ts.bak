import { Asset } from 'expo-asset';
import * as FileSystem from 'expo-file-system/legacy';
import * as SQLite from 'expo-sqlite';
import { MUSHAF_CACHE_DIR } from '../utils/mushafConstants';

const DB_NAME = 'qudratullah-indopak-15-lines.db';
const SQLITE_DIR = (FileSystem as any).documentDirectory + 'SQLite';
const TARGET_DB_PATH = `${SQLITE_DIR}/${DB_NAME}`;
const CACHE_DB_PATH = `${MUSHAF_CACHE_DIR}/${DB_NAME}`;

// Packaged asset path (adjust relative path if your asset location differs)
const ASSET_MODULE = require('../../assets/database/qudratullah-indopak-15-lines.db');

const TAG = 'mushafSurahService';
const isDev = __DEV__;
let ASSET_PATH: string | null = null;
let initialized = false;

function log(...args: any[]) { if (isDev) console.log(`[${TAG}]`, ...args); }
function logErr(...args: any[]) { console.error(`[${TAG}]`, ...args); }

async function loadAssetPath(): Promise<string> {
  if (ASSET_PATH) return ASSET_PATH;
  try {
    const asset = Asset.fromModule(ASSET_MODULE as any);
    if (!asset) throw new Error('Asset not found');
    await asset.downloadAsync();
    ASSET_PATH = asset.localUri || asset.uri || null;
    if (!ASSET_PATH) throw new Error('Asset has no localUri');
    log('Loaded packaged asset at', ASSET_PATH);
    return ASSET_PATH;
  } catch (e) {
    logErr('loadAssetPath failed, trying cache/bundle', e);
    // try cache path
    try {
      const info = await FileSystem.getInfoAsync(CACHE_DB_PATH);
      if (info.exists) { ASSET_PATH = CACHE_DB_PATH; log('Found DB in cache path'); return ASSET_PATH; }
    } catch (_err) { /* ignore */ }
    // try bundle-relative fallback
    try {
      const bundlePath = `${(FileSystem as any).documentDirectory}../${DB_NAME}`;
      const info2 = await FileSystem.getInfoAsync(bundlePath);
      if (info2.exists) { ASSET_PATH = bundlePath; log('Found DB in bundle path'); return ASSET_PATH; }
    } catch (_err) { /* ignore */ }
    throw new Error('Unable to resolve Mushaf DB asset');
  }
}

async function ensureSqliteDirectory(): Promise<void> {
  const dirInfo = await FileSystem.getInfoAsync(SQLITE_DIR);
  if (!dirInfo.exists) {
    await FileSystem.makeDirectoryAsync(SQLITE_DIR, { intermediates: true });
    log('Created SQLite dir:', SQLITE_DIR);
  }
}

async function copyDatabaseFile(): Promise<void> {
  const info = await FileSystem.getInfoAsync(TARGET_DB_PATH);
  if (info.exists) { log('DB already exists at target path'); return; }
  const assetPath = await loadAssetPath();
  log('Copying DB from', assetPath, 'to', TARGET_DB_PATH);
  await FileSystem.copyAsync({ from: assetPath, to: TARGET_DB_PATH });
  const ok = await FileSystem.getInfoAsync(TARGET_DB_PATH);
  if (!ok.exists) throw new Error('Copy failed: target missing');
  log('DB copied to target path');
}

async function ensureDbCopied(): Promise<void> {
  if (initialized) return;
  await ensureSqliteDirectory();
  await copyDatabaseFile();
  initialized = true;
}

function openDb(nameOrPath: string) {
  const anySqlite = (SQLite as any) || {};
  // prefer openDatabaseSync if available (used by some expo setups)
  if (typeof anySqlite.openDatabaseSync === 'function') {
    try { return anySqlite.openDatabaseSync(nameOrPath); } catch (e) { logErr('openDatabaseSync failed', e); }
  }
  // fallback to openDatabase
  if (typeof anySqlite.openDatabase === 'function') {
    try { return anySqlite.openDatabase(nameOrPath); } catch (e) { logErr('openDatabase failed', e); }
  }
  throw new Error('No sqlite open API available');
}

export async function getSurahStartPage(surahNumber: number): Promise<number> {
  try {
    await ensureDbCopied();
  } catch (e) {
    logErr('ensureDbCopied failed', e);
    return 1;
  }

  let db: any;
  try {
    db = openDb(DB_NAME);
  } catch (e) {
    logErr('openDb by name failed, trying by absolute path', e);
    try { db = openDb(TARGET_DB_PATH); } catch (e2) { logErr('openDb by path failed', e2); }
  }

  if (!db) { logErr('Unable to open DB'); return 1; }

  const sql = `SELECT MIN(page_number) as p FROM pages WHERE surah_number = ?`;

  // If db exposes executeSql directly (some bridges do)
  if (typeof db.executeSql === 'function') {
    try {
      return await new Promise<number>((resolve) => {
        db.executeSql(sql, [surahNumber], (_: any, result: any) => {
          try { const row = (result.rows as any).item(0); const p = row?.p ?? 1; log('executeSql result', { surahNumber, p }); resolve(Number(p)); }
          catch (e) { logErr('parse executeSql result failed', e); resolve(1); }
        }, (_: any, err: any) => { logErr('executeSql failed', err); resolve(1); return false; });
      });
    } catch (e) { logErr('executeSql call threw', e); }
  }

  // Otherwise use transaction
  return await new Promise<number>((resolve) => {
    try {
      db.transaction((tx: any) => {
        tx.executeSql(sql, [surahNumber], (_: any, result: any) => {
          try { const row = (result.rows as any).item(0); const p = row?.p ?? 1; log('transaction result', { surahNumber, p }); resolve(Number(p)); }
          catch (e) { logErr('parse transaction result failed', e); resolve(1); }
        }, (_: any, err: any) => { logErr('transaction executeSql failed', err); resolve(1); return false; });
      }, (txErr: any) => { logErr('transaction failed', txErr); resolve(1); });
    } catch (e) { logErr('transaction call threw', e); resolve(1); }
  });
}

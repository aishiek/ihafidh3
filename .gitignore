*.p12
*.key
*.mobileprovision
android/app/build/
ios/build/

# Signing keystores — never commit a real release key.
# debug.keystore is the shared, non-secret RN/Android debug key and is fine to track.
*.keystore
!debug.keystore

# Local gradle properties can carry release-signing credentials (MYAPP_UPLOAD_*).
# Keep those in ~/.gradle/gradle.properties (user-level, never committed) instead.
android/local.properties

# Metro
.metro-health-check*

# debug
npm-debug.*
yarn-debug.*
yarn-error.*

# macOS
.DS_Store
*.pem

# local env files
.env
.env.production
.env.development
.env.local
.env.*.local

# typescript
*.tsbuildinfo

# video files
*.mp4
*.mov
*.avi
*.mkv

app-example

# Firebase service account
firebaseServiceAccountKey.json
# Seeding tools (sensitive credentials - never commit)
firebase-seed/serviceAccountKey.json
firebase-seed/node_modules/
